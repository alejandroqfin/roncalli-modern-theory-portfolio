# 1.4. TANGENCY PORTFOLIO

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from scipy.optimize import minimize

# DATOS

mus = np.array([0.15, 0.10, 0.08, 0.06])

sigmas = np.array([0.15, 0.10, 0.07, 0.05])

corr = np.array([
    [1.00, 0.50, 0.20, 0.00],
    [0.50, 1.00, 0.20, 0.00],
    [0.20, 0.20, 1.00, 0.00],
    [0.00, 0.00, 0.00, 1.00]
])

n = len(mus)

# RESTRICCIONES

long_only = tuple((0, 1) for _ in range(n))
cons1 = ({'type': 'eq', 'fun': lambda x: np.sum(x) - 1},)

# FUNCIONES

def portfolio_return(x):
    return x @ mus

def funcion_objetivo(x):
    return -(x @ mus)

def portfolio_varianza(x): 
    return x @ Sigma @ x

def portfolio_volatility(x):
    return np.sqrt(x @ Sigma @ x)

def portfolio_sharpe(mu, sigma):
    return (mu - rf) / sigma

def information_ratio(x, mu, x_benchmark, Sigma):
    Rp = x @ mu
    Rb = x_benchmark @ mu
    d = x - x_benchmark
    TEV = np.sqrt(d @ Sigma @ d)
    
    if TEV == 0:
        return 0.0
    else:
        return (Rp - Rb) / TEV

# 1) CALCULA LA CARTERA TANGENTE

lista_rf = [0.02, 0.03, 0.04]

diag = np.diag(sigmas)
Sigma = diag @ corr @ diag
invSigma = np.linalg.inv(Sigma)

# CARTERA TANGENTE DE ACTIVOS RIESGOSOS

filas = [f"x*{i+1}" for i in range(n)] + ["mu", "sigma", "sharpe"]
tabla = pd.DataFrame(index=filas)

for rf in lista_rf:

    v = invSigma @ (mus - rf * np.ones(n))
    x_tangente = v / v.sum()
    mu_tangente = x_tangente @ mus
    sigma_tangente = np.sqrt(x_tangente @ Sigma @ x_tangente)
    sharpe_tangente = portfolio_sharpe(mu_tangente, sigma_tangente)

    datos = np.append(x_tangente, [mu_tangente, sigma_tangente, sharpe_tangente])
    tabla[f"RF = {int(rf*100)}%"] = datos
    
# TABLA CARTERA TANGENTE

tabla = tabla * 100
print("\nCartera tangente o de mercado (en %):")
print(tabla.round(3))

# EXPLICACIÓN:
    
# Si sube RF, la frontera eficiente se “estrecha” y la cartera tangente 
# debe asumir más riesgo para seguir siendo la de máximo Sharpe. 
# Por eso aumenta la exposición a activos de alta volatilidad 
# y se reduce la de activos conservadores.

# 2) TRACKING ERROR VOLATILITY (TEV)

rf = 0.03

# BENCHMARK

x_benchmark = np.array([0.60, 0.30, 0.10, 0.00])

def TEV(x, b, Sigma):
    d = x - b
    TEV = np.sqrt(d @ Sigma @ d)
    return TEV

# OPTIMIZAR TEV CON RESTRICCIÓN LONG-ONLY Y SUMA 1

# 2a) MINIMIZAR EL TEV

def minimizar_TEV(x, b, Sigma):
    return 0.5 * x @ Sigma @ x - x @ Sigma @ b

x0 = x_benchmark.copy()

resultado_minimizar = minimize(minimizar_TEV, x0, args=(x_benchmark, Sigma), method='SLSQP', bounds=long_only, constraints=cons1)

if not resultado_minimizar.success:
    print("La optimización no encontró solución.")

x_min_TEV = resultado_minimizar.x.round(4)
TEV_min = TEV(x_min_TEV, x_benchmark, Sigma)

print("\nResultado QP - minimizar TEV (long-only, suma=1):")
print("x*:", x_min_TEV)
print("Tracking Error (TEV):", float(np.round(TEV_min, 6)))
print("El resultado de minimizar el TEV da el Benchmark")

# 2b) MAXIMIZAR EL TEV

# CAMBIAMOS EL SIGNO A LA FUNCIÓN OBJETIVO

def maximizar_TEV(x, b, Sigma):
    return - (0.5 * x @ Sigma @ x - x @ Sigma @ b)

x0 = np.array([0.2, 0.2, 0.2, 0.4]) # PARA QUE NO COJA UN ÓPTIMO LOCAL

resultado_maximizar = minimize(maximizar_TEV, x0, args=(x_benchmark, Sigma), bounds=long_only, constraints=cons1)

if not resultado_maximizar.success:
    print("La optimización no encontró solución.")

x_max_TEV = np.round(resultado_maximizar.x, 4)
TEV_max = TEV(x_max_TEV, x_benchmark, Sigma)

print("\nResultado QP - maximizar TEV (long-only, suma=1):")
print("x*:", x_max_TEV)
print("Tracking Error (TEV):", float(np.round(TEV_max, 6)))
print("Maximizar TEV es sinónimo de invertir 100% en el activo que el benchmark ignora y que aporta más volatilidad no correlacionada. (Activo 4)")

# GRÁFICO COMPARATIVO

