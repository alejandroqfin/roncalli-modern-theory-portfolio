width = 0.25

fig, ax = plt.subplots(figsize=(8,5))

ax.bar(x - width, x_benchmark, width, label='Benchmark', color='skyblue')
ax.bar(x, x_min_TEV, width, label='Min TEV', color='green')
ax.bar(x + width, x_max_TEV, width, label='Max TEV', color='orange')

ax.set_ylabel('Peso en cartera')
ax.set_title('Benchmark vs Min TEV vs Max TEV')
ax.set_xticks(x)
ax.set_xticklabels(activos)
ax.set_ylim(0,1)
ax.legend()

plt.show()

# 3) CALCULA LA CARTERA QUE MAXIMIZA EL INFORMATION RATIO

def maximizar_IR(x, mu, x_benchmark, Sigma):
    return - information_ratio(x, mu, x_benchmark, Sigma)

# CONDICIÓN INICIAL

x0 = np.array([0.25, 0.25, 0.25, 0.25])

resultado_IR = minimize(maximizar_IR, x0, args=(mus, x_benchmark, Sigma),method='SLSQP', bounds=long_only, constraints=cons1)

if not resultado_IR.success:
    print("La optimización no encontró solución.")

x_max_IR = resultado_IR.x.round(4)
IR_optimo = information_ratio(x_max_IR, mus, x_benchmark, Sigma)

print("\nCartera que maximiza el Information Ratio:")
print("x*:", x_max_IR)
print("Information Ratio:", float(np.round(IR_optimo,6)))

# TABLA COMPARATIVA DE TODAS LAS CARTERAS

