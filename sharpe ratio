# 6) CASO CARTERA EQUIPONDERADA + CORR CTE + COV CTE

def sharpe_ratio_equiponderada_corrcte(mu, sigma, rf, rho):
    
    n = len(mu)
    num = n**(-1) * np.sum(mu - rf)
    den = sigma * np.sqrt(rho + (1/n) * (1 - rho))
    return num / den

# PROPORCIONALIDAD DEL SR CON LA MEDIA DE LOS SRi CON RGO CTE

def sharpe_ratio_combinacion_media(mu, sigma, rf, rho):
    
    n = len(mu)
    w = 1 / (rho + n**(-1) * (1 - rho))
    SR_mean = (np.sum(mu - rf) / sigma) / n
    return w * SR_mean

# 7) FUNCIÓN QUE CALCULA EL NUMERO DE ACTIVOS NECESARIOS PARA MEJORAR EL SR UN W%

def mejorar_sharpe(rho, mejora):
    """
    Calcula el número de activos necesarios para mejorar el Sharpe ratio.

    Parámetros:
    rho : Nivel de correlación entre los activos (entre 0 y 1).
    mejora_sr : Porcentaje de mejora deseada en el Sharpe ratio (ej: 0.2 = +20%).

    Retorna:
    n : Número de activos que habría que añadir
    """
    n = ((1 + mejora)**2 * (1 - rho)) / (1 - rho * (1 + mejora)**2)
    
    if n <= 0:
        mensaje = f"No podemos mejorar el SR para una correlación de {rho}"
        return 0, mensaje
    
    n_aprox = math.ceil(n)
    mensaje = f"Habría que añadir {n:.2f} ≈ {n_aprox} activos para mejorar el Sharpe un {100*mejora:.0f}% respecto al original"
    return n_aprox, mensaje

