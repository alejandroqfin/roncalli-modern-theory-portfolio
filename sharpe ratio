# EJERCICIO 1.3. SHARPE RATIO

import numpy as np
import pandas as pd
import math

# 1) RATIO DE SHARPE

def sharpe_ratio(mu, sigma, rf):
    if sigma == 0:
        raise ValueError("¡El activo es RF!")
    return (mu - rf) / sigma

# 2) RATIO DE SHARPE PARA UNA CARTERA CON 2 ACTIVOS

def sharpe_ratio_2(x1, mu1, mu2, sigma1, sigma2, rho, rf):
    # Caso especial: activo 2 es RF
    if sigma2 == 0 and np.isclose(mu2, rf):
        SR1 = sharpe_ratio(mu1, sigma1, rf)
        SR_p = np.sign(x1) * SR1 if x1 != 0 else 0
        
        print(f"SR1 = {SR1:.4f}, SR2 = RF")
        print(f"Sharpe de la cartera = {SR_p:.4f}")
        if x1 != 0:
            print(f"SR cartera = signo(x1) × SR1 = {np.sign(x1)} × {SR1:.4f}")
        return SR_p
    
    # Caso general
    x2 = 1 - x1
    mu_p = x1 * mu1 + x2 * mu2
    sigma_p = np.sqrt(x1**2 * sigma1**2 + x2**2 * sigma2**2 + 2 * x1 * x2 * rho * sigma1 * sigma2)
    
    if sigma_p == 0:
        raise ValueError("¡La cartera es RF!")

    SR1 = sharpe_ratio(mu1, sigma1, rf)
    SR2 = sharpe_ratio(mu2, sigma2, rf)
    SR_p = (mu_p - rf) / sigma_p

    print(f"SR1 = {SR1:.4f}, SR2 = {SR2:.4f}")
    print(f"Sharpe de la cartera = {SR_p:.4f}")

    return SR_p

