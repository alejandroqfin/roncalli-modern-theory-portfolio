print(f"Sharpe Ratio cartera: {SR_port:.4f}")

# MISMO CASO PERO EL SR COMO INPUT

def sharpe_ratio_combinacion_2(sigma, SR):
    
    x = sigma / np.sqrt(np.sum(sigma**2))
    SR_port = np.sum(x * SR)
    
    return SR_port, x

