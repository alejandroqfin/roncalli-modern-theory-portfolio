# 4) RATIO DE SHARPE DE UNA CARTERA CON N ACTIVOS

def sharpe_ratio_n(mu, sigma, x, rf):
    mu_p = np.sum(x * mu)
    sigma_p = np.sqrt(np.sum((x * sigma)**2))
    return (mu_p - rf) / sigma_p

# RATIO DE SHARPE DE UNA CARTERA EQUIPONDERADA CON X = 1/N
# Particularidad: no depende de x

def sharpe_ratio_equiponderada(mu, sigma, rf):
    num = np.sum(mu - rf)
    den = np.sqrt(np.sum(sigma**2))
    if den == 0:
        raise ValueError("Denominador 0: cartera libre de riesgo.")
    return num / den

