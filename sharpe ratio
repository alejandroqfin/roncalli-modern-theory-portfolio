# 5) RATIO DE SHARPE DE LA CARTERA COMO COMBINACION LINEAL

def sharpe_ratio_combinacion(mu, sigma, rf):
    
    SR_i = (mu - rf) / sigma
    x = sigma / np.sqrt(np.sum(sigma**2))
    SR_port = np.sum(x * SR_i)
    
    return SR_port, x, SR_i

