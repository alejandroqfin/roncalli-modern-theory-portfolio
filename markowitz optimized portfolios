# 6) FORMULA EL PROBLEMA DUAL

S = np.array([[-1, 0, 0]])
T = np.array([-0.08])

def solve_dual(S, T, Sigma, mu, phi):
    """
    Resuelve el dual QP: min_{lam>=0} 1/2 lam' Q lam - lam' R
    con Q = S Σ^{-1} S'  y  R = (1/phi) S Σ^{-1} mu - T
    """
    inv_Sigma = np.linalg.inv(Sigma)
    gamma = 1.0 / phi
    Q = S @ inv_Sigma @ S.T
    R = gamma * (S @ inv_Sigma @ mu) - T

    nlam = Q.shape[0]
    funcion_dual = lambda lam: 0.5 * float(lam @ (Q @ lam)) - float(lam @ R)
    bounds_lam = [(0.0, None)] * nlam
    lam0 = np.zeros(nlam)

    resultado = minimize(funcion_dual, lam0, method='SLSQP', bounds=bounds_lam, options={'ftol':1e-12})
    return resultado.x, resultado.fun, resultado.message

