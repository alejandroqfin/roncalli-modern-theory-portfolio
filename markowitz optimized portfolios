    [1.00, 0.50, 0.20],
    [0.50, 1.00, 0.20],
    [0.20, 0.20, 1.00]
])

# 1) CALCULA LA CARTERA DE MÍNIMA VARIANZA (GMV)

# CÁLCULO DE SIGMA

S = np.diag(sigmas)
Sigma = S @ corr @ S

# CÁLCULO DE LOS PESOS GMV (FÓRMULA RONCALLI)

ones = np.ones(len(sigmas))
inv_Sigma = np.linalg.inv(Sigma)
u = inv_Sigma @ ones
w = u / (ones @ u)

# RESULTADOS

print("\nMatriz de covarianzas Σ:\n", Sigma.round(5))
print("\nMatriz de covarianzas inversa Σ^-1:\n", inv_Sigma.round(5))
print("\nCartera (GMV) sin restricciones:")
print("Pesos óptimos:", w.round(4))
print("Suma pesos:", round(w.sum(), 4))

mu_p = mus @ w
sigma_p = np.sqrt(w.T @ Sigma @ w)
phi_p = ((ones @ inv_Sigma @ mus) - mu_p * (ones @ inv_Sigma @ ones)) / (1 - (sigma_p**2) * (ones @ inv_Sigma @ ones))

print("Rentabilidad esperada de la cartera:", round(mu_p, 4))
print("Volatilidad de la cartera:", round(sigma_p, 4))
print("Aversión al riesgo:", round(phi_p, 4))

